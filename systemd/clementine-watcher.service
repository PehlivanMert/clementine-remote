[Unit]
Description=Clementine Web Remote Lifecycle Watcher
Documentation=https://github.com/clementine-player/Clementine
After=graphical-session.target sound.target network.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/mert/clementine-web-remote
ExecStart=/usr/bin/python3 /home/mert/clementine-web-remote/scripts/clementine_watcher.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
WantedBy=default.target
